# Code generated by cmd/gendoc; DO NOT EDIT.
#
# dnspatch example configuration. Copy it to dnspatch.toml, replace the
# placeholders, and delete the definitions you do not use.
#
# Uncommented parameters are required. A commented parameter is optional and
# shows its default; uncomment it to change it. Every parameter is described in
# docs/PARAMETERS.md. A value such as ${NAME} is read from the environment.
#
# This file is generated from plugin struct tags, so manual edits are
# overwritten. After changing a plugin configuration, run `go generate ./...`.

# How often instances check the address. An instance can set its own.
interval = "5m"

# ----------------------------------------------------------------------------
# Retrievers: where the current address comes from.
# ----------------------------------------------------------------------------

[retriever.2ip]
type = "2ip"

# Base URL of the service; change it to use a self-hosted instance
# base_url = "https://api.2ip.io"

# URL of a proxy to send requests through: socks5, socks5h, http or https,
# optionally with user:pass@ (percent-encode special characters).
# proxy = "direct"

[retriever.icanhazip]
type = "icanhazip"

# Base URL of the service; icanhazip.com is dual-stack and replies over
# whichever IP family the request arrives on
# base_url = "https://icanhazip.com"

# IP family to ask for: ipv4, ipv6, or dual to fetch both with two requests.
# family = "ipv4"

# URL of a proxy to send requests through: socks5, socks5h, http or https,
# optionally with user:pass@ (percent-encode special characters).
# proxy = "direct"

[retriever.identme]
type = "identme"

# Base URL of the service; ident.me is dual-stack and replies over whichever
# IP family the request arrives on
# base_url = "https://ident.me"

# IP family to ask for: ipv4, ipv6, or dual to fetch both with two requests.
# family = "ipv4"

# URL of a proxy to send requests through: socks5, socks5h, http or https,
# optionally with user:pass@ (percent-encode special characters).
# proxy = "direct"

[retriever.ifconfigco]
type = "ifconfigco"

# Base URL of the service; change it to use a self-hosted instance
# base_url = "https://ifconfig.co"

# IP family to ask for: ipv4, ipv6, or dual to fetch both with two requests.
# family = "ipv4"

# URL of a proxy to send requests through: socks5, socks5h, http or https,
# optionally with user:pass@ (percent-encode special characters).
# proxy = "direct"

[retriever.interface]
type = "interface"

# Name of the network interface to read, for example eth0, wan or Ethernet.
name = "CHANGE_ME"

# IP family to read: ipv4, ipv6, or dual to read both. dual fails when the
# interface has no suitable address of either family
# family = "ipv6"

# Optional CIDR prefix, for example 2001:db8:1234::/64: only addresses inside
# it are considered.
# network = ""

[retriever.ipify]
type = "ipify"

# Base URL of the service; api64.ipify.org is dual-stack and replies over
# whichever IP family the request arrives on
# base_url = "https://api64.ipify.org"

# IP family to ask for: ipv4, ipv6, or dual to fetch both with two requests.
# family = "ipv4"

# URL of a proxy to send requests through: socks5, socks5h, http or https,
# optionally with user:pass@ (percent-encode special characters).
# proxy = "direct"

# ----------------------------------------------------------------------------
# Providers: where the address is published.
# ----------------------------------------------------------------------------

[provider.beget]
type = "beget"

# Beget account login used for API calls
login = "CHANGE_ME"

# Beget account password
password = "${BEGET_PASSWORD}"

# Domain name of the zone, for example example.com
zone = "example.com"

# Record name relative to the zone: @ for the apex, * for a wildcard, or a
# label such as home
rr_name = "home"

# Base URL of the API
# base_url = "https://api.beget.com/api"

# URL of a proxy to send API requests through, for example
# socks5://user:pass@203.0.113.5:1080.
# proxy = "socks5://user:pass@203.0.113.5:1080"

[provider.regru]
type = "regru"

# REG.RU account login used for API calls
username = "CHANGE_ME"

# API password; set an alternative password for the API in the REG.RU account
# and allow the address dnspatch runs from
password = "${REGRU_PASSWORD}"

# Domain name of the zone, for example example.com
zone = "example.com"

# Record name relative to the zone: @ for the apex, * for a wildcard, or a
# label such as home
rr_name = "home"

# Base URL of the API
# base_url = "https://api.reg.ru/api/regru2"

# URL of a proxy to send API requests through, for example
# socks5://user:pass@203.0.113.5:1080.
# proxy = "socks5://user:pass@203.0.113.5:1080"

[provider.rfc2136]
type = "rfc2136"

# Address of the name server that accepts updates, as host or host:port.
server = "ns1.example.com:53"

# Domain name of the zone the server is authoritative for, for example
# example.com
zone = "example.com"

# Record name relative to the zone: @ for the apex, * for a wildcard, or a
# label such as home
rr_name = "home"

# Name of the TSIG key used to sign updates, as configured on the server.
# key_name = "dnspatch-key"

# Base64-encoded secret of the TSIG key, as printed by tsig-keygen
# key_secret = "${TSIG_SECRET}"

# TSIG algorithm of the key: hmac-sha1, hmac-sha224, hmac-sha256, hmac-sha384
# or hmac-sha512
# key_algorithm = "hmac-sha256"

# TTL in seconds of the record this provider writes
# ttl = 300

# Transport of the update: tcp or udp.
# protocol = "tcp"

# How long to wait for the server to answer an update
# timeout = "10s"

[provider.selectel]
type = "selectel"

# Selectel account ID (the domain name used for API auth), shown in the top
# right corner of the Control panel
account_id = "CHANGE_ME"

# Name of the service user used for API calls
username = "CHANGE_ME"

# Password of the service user
password = "${SELECTEL_PASSWORD}"

# Name of the project the DNS zone belongs to
project_name = "CHANGE_ME"

# Domain name of the zone, for example example.com
zone = "example.com"

# Record name relative to the zone: @ for the apex, * for a wildcard, or a
# label such as home
rr_name = "home"

# TTL in seconds for a record this provider creates; an existing record keeps
# its own TTL.
# ttl = 60

# Base URL of the identity (Keystone) API used to obtain a project IAM token
# auth_url = "https://cloud.api.selcloud.ru/identity/v3"

# Base URL of the DNS Hosting API
# base_url = "https://api.selectel.ru/domains/v2"

# URL of a proxy to send API requests through, for example
# socks5://user:pass@203.0.113.5:1080.
# proxy = "socks5://user:pass@203.0.113.5:1080"

# ----------------------------------------------------------------------------
# Instances: each one ties one or two retrievers to the providers it updates.
# ----------------------------------------------------------------------------

# Add more [[instance.provider]] tables to update several providers. Parameters
# set next to a ref override the definition, for example another zone.
[[instance]]
name = "home"

[[instance.retriever]]
ref = "2ip"

# A second [[instance.retriever]] table adds a retriever for the other address
# family; each instance accepts one or two retrievers, one per family.
[[instance.provider]]
ref = "beget"
