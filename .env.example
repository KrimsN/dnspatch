# Environment of the dnspatch container. Copy to .env and fill in.
#
# Docker Compose passes every variable in this file to the container, and
# dnspatch.toml reads them as ${NAME}. Keep secrets here rather than in the
# configuration file.

# Password of the DNS provider account, for a provider with
# password = "${PASSWORD}" (see docs/PARAMETERS.md).
PASSWORD=change-me

# Proxy for provider API requests, for a provider with proxy = "${PROXY_URL}".
# PROXY_URL=socks5://user:pass@203.0.113.5:1080

# Log level: debug, info (default), warn or error. Debug also shows why a
# provider was skipped.
# DNSPATCH_LOG_LEVEL=debug

# Image tag to run. The default is latest; pin a release for reproducibility.
# DNSPATCH_VERSION=0.1.0
